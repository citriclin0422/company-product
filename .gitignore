# ==============================================================================
# Git Ignore Rules for PJ1_company-product (Web Application)
# ==============================================================================

# Ignore all hidden directories and files (starting with dot)
.*
!.gitignore

# Explicitly ignore documentation and preparation directories
.md_doc/
.preparation/
.agents/
.gemini/
.system_generated/
.idea/
.vscode/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Logs & Runtime
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node / Dependency Directories (if added in future)
node_modules/
jspm_packages/

# Build & Temporary Files
dist/
build/
out/
tmp/
temp/
*.tmp
*.bak
*.swp